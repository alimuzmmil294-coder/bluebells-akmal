# ==============================================================================
# BlueBells Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (Primary Database)
# In development, falls back automatically to MongoMemoryServer if unreachable.
# In production, must point to your live MongoDB instance / MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/bluebells
MONGO_URI=mongodb://127.0.0.1:27017/bluebells

# Optional custom directory for development in-memory MongoDB fallback.
# Choose a writable directory with at least 1 GB free space.
MONGODB_MEMORY_DIR=

# Session Secret (Must be >= 32 characters; 64-character hex recommended)
SESSION_SECRET=your_super_secret_64_character_hex_session_key_here

# Optional JWT Secret placeholder (for microservices/token integrations)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters

# Client / Storefront URLs for CORS & Cookie Origin Validation
CLIENT_URL=http://localhost:5173
CLIENT_URLS=https://bluebells-akmal-5st6.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Master Administrator Seed Credentials (Required in production)
ADMIN_NAME="BlueBells Master Admin"
ADMIN_EMAIL=admin@bluebells.pk
ADMIN_PASSWORD=adminpass
