# ==============================================================================
# BlueBells Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (Primary)
MONGODB_URI=mongodb://127.0.0.1:27017/bluebells

# Optional custom directory for the development in-memory MongoDB fallback.
# Choose a writable directory with at least 1 GB free space.
MONGODB_MEMORY_DIR=

# Session Secret (Must be >= 32 characters; 64-character hex recommended)
SESSION_SECRET=your_super_secret_64_character_hex_session_key_here

# Client / Storefront URLs for CORS & Cookie Origin Validation
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173,https://bluebells-vv44.vercel.app

# Master Administrator Seed Credentials (Required in production)
ADMIN_NAME="BlueBells Master Admin"
ADMIN_EMAIL=admin@bluebells.pk
ADMIN_PASSWORD=adminpass
