# ==============================================================================
# BlueBells Frontend Environment Configuration (.env.example)
# ==============================================================================

# API Base URL. Use /api for local development with the Vite proxy.
# For standalone production, set to your deployed backend (e.g. https://bluebells-akmal.vercel.app/api).
VITE_API_URL=/api

# Backend Server URL targeted by Vite's development reverse proxy (/api and /uploads)
BACKEND_URL=http://127.0.0.1:5000
